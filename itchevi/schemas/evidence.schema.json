{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itchevi:schema:evidence:0.4.0",
  "title": "ItchEvi evidence records",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["record_id", "entity_id", "layer_id", "dataset_id", "evidence_role", "statistical_unit", "paired_or_descriptive", "effect", "SE", "P", "FDR", "direction", "n_independent_units", "quality_multiplier", "terminal_state", "failure_code", "source_confidence", "input_sha256", "config_sha256", "software_version", "gate_status"],
    "properties": {
      "record_id": {"type": "string", "minLength": 1},
      "entity_id": {"type": "string", "minLength": 1},
      "layer_id": {"type": "string", "minLength": 1},
      "dataset_id": {"type": "string", "minLength": 1},
      "evidence_role": {"enum": ["construction", "evaluation", "optional_context", "negative_control"]},
      "statistical_unit": {"type": "string", "minLength": 1},
      "paired_or_descriptive": {"enum": ["paired_inferential", "unpaired_inferential", "descriptive"]},
      "effect": {"type": ["number", "null"]},
      "SE": {"type": ["number", "null"], "minimum": 0},
      "P": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
      "FDR": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
      "direction": {"type": ["integer", "null"], "enum": [-1, 0, 1, null]},
      "n_independent_units": {"type": "integer", "minimum": 0},
      "quality_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
      "terminal_state": {"enum": ["OBSERVED", "MISSING", "FAILED", "NOT_APPLICABLE"]},
      "failure_code": {"type": "string"},
      "source_confidence": {"enum": ["high", "medium", "low", "unresolved"]},
      "input_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
      "config_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
      "software_version": {"type": "string", "minLength": 1},
      "gate_status": {"enum": ["PASS", "WEAK", "FAIL", "NOT_TESTED", ""]}
    }
  }
}
